<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        x:Class="TuxDdsGui.Views.BatchConvertWizardWindow"
        Title="TuxDDS - Batch Convert Wizard"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="15" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto, 30, Auto">
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Label Content="Folder with DDS files to convert:" />
                <Grid ColumnDefinitions="200, 10, 30">
                    <TextBox Grid.Column="0" Name="TbInputFolder" />
                    <Button Grid.Column="2" Content="..." Click="BtnSelectInputFolderClicked" />
                </Grid>
                <CheckBox Content="Search folders recursively" Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <Label Content="Output folder:" />
                <Grid ColumnDefinitions="200, 10, 30">
                    <TextBox Grid.Column="0" Name="TbOutputFolder" />
                    <Button Grid.Column="2" Content="..." Click="BtnSelectOutputFolderClicked" />
                </Grid>
                <CheckBox Content="Keep folder structure" Margin="0,10,0,0" />
            </StackPanel>
            <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15" />
            <StackPanel Grid.Row="2" Grid.Column="0">
                <Label Content="Output name:" />
                <RadioButton Name="RbKeepName" Content="Keep name" IsChecked="True" />
                <RadioButton Name="RbBatchRename" Content="Batch rename to: " Margin="0,5,0,0" />
                <TextBox Name="TbBatchRename" Width="240" HorizontalAlignment="Left" />
                <Label Content="path/to/file/file1.dds" Foreground="Gray" FontSize="11" />
                <RadioButton Name="RbAppendName" Content="Append to name: " Margin="0,5,0,0" />
                <TextBox Name="TbAppendName" Width="240" HorizontalAlignment="Left" />
                <Label Content="path/to/file/file1-append.dds" Foreground="Gray" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <Label Content="Output format:" />
                <ComboBox Name="CbOutputFormats" Width="240" />
            </StackPanel>
            <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15" />
            <Button Name="BtnConvert" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Content="Convert"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="240" Height="40" Margin="0,5,0,5" IsEnabled="False" />
        </Grid>
    </ScrollViewer>
</Window>